{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "github": {
    "enabled": true
  },
  "buildCommand": "npm install && prisma generate",
  "crons": [
    {
      "path": "/api/cron/auto-close-schedules",
      "schedule": "59 15 * * *"
    }
  ]
}
