generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  departmentId String              @id @db.VarChar(36)
  name         String              @unique
  logoUrl      String
  trainers     DepartmentTrainer[]
  distributors Distributor[]
  shows        Show[]
}

model DepartmentTrainer {
  departmentId String
  userId       String
  department   Department @relation(fields: [departmentId], references: [departmentId])
  user         User       @relation(fields: [userId], references: [userId])

  @@id([departmentId, userId])
  @@index([userId])
  @@index([departmentId])
}

model Distributor {
  userId          String           @id @unique(map: "userId_UNIQUE") @db.VarChar(36)
  departmentId    String?          @db.VarChar(36)
  contactNumber   String           @db.VarChar(20)
  distributorType DistributorTypes
  hasCommission   Boolean          @default(true)
  user            User             @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "distributor_ibfk_1")
  department      Department?      @relation(fields: [departmentId], references: [departmentId], onDelete: Restrict, map: "distributor_ibfk_3")

  @@index([distributorType])
  @@index([departmentId], map: "distributor_ibfk_3")
}

model Genre {
  name       String      @id @db.VarChar(100)
  showGenres ShowGenre[] @relation("ShowGenre_GenreToGenre")
}

model ShowGenre {
  showId  String @db.VarChar(36)
  genre   String @db.VarChar(100)
  show    Show   @relation(fields: [showId], references: [showId], onDelete: Cascade, map: "showgenre_ibfk_1")
  genreFk Genre  @relation("ShowGenre_GenreToGenre", fields: [genre], references: [name], map: "showgenre_ibfk_2")

  @@id([showId, genre])
  @@index([genre], map: "showgenre_ibfk_2_idx")
}

model Show {
  showId       String         @id @db.VarChar(36)
  title        String         @db.VarChar(255)
  description  String         @db.Text
  showType     ShowType
  departmentId String?        @db.VarChar(36)
  createdBy    String         @db.VarChar(36)
  createdAt    DateTime       @default(now()) @db.Timestamp(0)
  isArchived   Boolean        @default(false)
  showCover    String         @db.Text
  department   Department?    @relation(fields: [departmentId], references: [departmentId], onDelete: Restrict, map: "shows_ibfk_1")
  creator      User           @relation(fields: [createdBy], references: [userId], map: "shows_ibfk_2")
  genres       ShowGenre[]
  schedules    ShowSchedule[]

  @@index([departmentId], map: "shows_ibfk_1")
  @@index([createdBy], map: "shows_ibfk_2")
}

model ShowSchedule {
  scheduleId      String            @id @db.VarChar(36)
  showId          String            @db.VarChar(36)
  isOpen          Boolean?          @default(true)
  isRescheduled   Boolean?          @default(false)
  seatingType     SeatingType
  ticketType      TicketType
  contactNumber   String?           @db.VarChar(20)
  facebookLink    String?           @db.VarChar(255)
  femaleCount     Int?              @default(0)
  maleCount       Int?              @default(0)
  datetime        DateTime          @db.DateTime(0)
  ticketPricing   Json
  show            Show              @relation(fields: [showId], references: [showId], onDelete: Cascade, map: "showschedules_ibfk_1")
  seats           ShowSeat[]
  tickets         Ticket[]
  ticketLogs      TicketActionLog[]

  @@index([showId], map: "showschedules_ibfk_1")
}

model ShowSeat {
  scheduleId  String       @db.VarChar(36)
  seatNumber  String       @db.VarChar(10)
  seatSection SeatSection
  status      SeatStatus?  @default(available)
  x           Float        @db.Float
  y           Float        @db.Float
  ticketId    String?      @db.VarChar(36)
  rotation    String?      @db.VarChar(45)
  schedule    ShowSchedule @relation(fields: [scheduleId], references: [scheduleId], onDelete: Cascade, map: "showseats_ibfk_1")
  ticket      Ticket?      @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade, map: "ticket_fk_2")

  @@id([scheduleId, seatNumber])
  @@index([ticketId], map: "ticket_fk_2_idx")
}

model Ticket {
  ticketId           String       @id @db.VarChar(36)
  controlNumber      Int
  scheduleId         String       @db.VarChar(36)
  discountPercentage Decimal?     @db.Decimal(5, 2)
  status             TicketStatus @default(not_allocated)
  distributorId      String?      @db.VarChar(36)
  isComplimentary    Boolean?     @default(false)
  ticketPrice        Decimal?     @db.Decimal(10, 2)
  customerName       String?      @db.VarChar(45)
  customerEmail      String?      @db.VarChar(45)
  trainerSold        Boolean      @default(false)
  seats              ShowSeat[]
  schedule           ShowSchedule @relation(fields: [scheduleId], references: [scheduleId], onDelete: Cascade, map: "ticket_ibfk_1")
  distributor        User?        @relation(fields: [distributorId], references: [userId], onDelete: Restrict, map: "ticket_ibfk_2")
  logs               TicketLog[]

  @@index([distributorId], map: "distributorId")
  @@index([scheduleId], map: "ticket_ibfk_1_idx")
  @@index([controlNumber], map: "ticket_controlNumber_idx")
}

model User {
  userId            String                 @id @db.VarChar(36)
  firstName         String                 @db.VarChar(100)
  lastName          String                 @db.VarChar(100)
  email             String                 @unique(map: "email") @db.VarChar(150)
  password          String                 @db.VarChar(255)
  createdAt         DateTime               @default(now()) @db.Timestamp(0)
  isArchived        Boolean                @default(false)
  isDefaultPassword Boolean                @default(true)
  departments       DepartmentTrainer[]
  distributor       Distributor?
  notifications     Notification[]         @relation("Notification_SenderToUser")
  deliveries        NotificationDelivery[]
  shows             Show[]
  tickets           Ticket[]
  ticketLogsBy      TicketActionLog[]      @relation("TicketActionLog_ByUser")
  ticketLogsDist    TicketActionLog[]      @relation("TicketActionLog_Distributor")
  roles             UserRole[]
}

model UserRole {
  userId String       @db.VarChar(36)
  role   UserRoleRole
  user   User         @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "fk_1")

  @@id([userId, role])
  @@index([role], map: "roles")
}

model TicketActionLog {
  actionLogId     String           @id @db.VarChar(36)
  scheduleId      String           @db.VarChar(36)
  distributorId   String?          @db.VarChar(36)
  actionBy        String           @db.VarChar(36)
  actionDate      DateTime         @default(now()) @db.Timestamp(0)
  remarks         String?          @db.Text
  totalRemittance Decimal?         @db.Decimal(10, 2)
  commission      Decimal?         @db.Decimal(10, 2)
  actionType      TicketActionType
  metaData        Json?
  actionByUser    User             @relation("TicketActionLog_ByUser", fields: [actionBy], references: [userId], map: "actionby_fk3")
  distributor     User?            @relation("TicketActionLog_Distributor", fields: [distributorId], references: [userId], map: "distributor_fk2")
  schedule        ShowSchedule     @relation(fields: [scheduleId], references: [scheduleId], onDelete: Cascade, map: "schedule_fk1")
  logs            TicketLog[]

  @@index([actionBy], map: "actionby_fk3_idx")
  @@index([distributorId], map: "distributor_fk2_idx")
  @@index([scheduleId], map: "schedule_fk1_idx")
}

model TicketLog {
  actionLogId String          @db.VarChar(36)
  ticketId    String          @db.VarChar(36)
  action      TicketActionLog @relation(fields: [actionLogId], references: [actionLogId], onDelete: Cascade, map: "action_fk1")
  ticket      Ticket          @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade, map: "ticket_fk2")

  @@id([actionLogId, ticketId])
  @@index([ticketId], map: "ticket_fk2_idx")
}

model Notification {
  notificationId String                 @id @db.VarChar(36)
  senderId       String                 @db.VarChar(36)
  message        String                 @db.Text
  title          String                 @db.VarChar(200)
  sentAt         DateTime?              @default(now()) @db.Timestamp(0)
  metaData       Json?
  type           NotificationType
  sender         User                   @relation("Notification_SenderToUser", fields: [senderId], references: [userId], onDelete: Cascade, map: "notifications_ibfk_1")
  deliveries     NotificationDelivery[]

  @@index([senderId], map: "notification_fk1_idx")
}

model NotificationDelivery {
  id             String       @id @db.VarChar(36)
  notificationId String       @db.VarChar(36)
  recipientId    String       @db.VarChar(36)
  readAt         DateTime?    @db.Timestamp(0)
  recipient      User         @relation(fields: [recipientId], references: [userId], onDelete: Cascade, map: "delivery_fk1")
  notification   Notification @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade, map: "delivery_fk2")

  @@index([recipientId], map: "delivery_fk1_idx")
  @@index([notificationId], map: "delivery_fk2")
}



enum ShowType {
  showCase
  majorConcert
  majorProduction
}

enum SeatStatus {
  reserved
  available
  sold
  paidToCCA
  complimentarySeat
}

enum TicketStatus {
  remitted
  paidToCCA
  sold
  lost
  not_allocated
  allocated
}

enum SeatingType {
  freeSeating
  controlledSeating
}

enum TicketType {
  ticketed
  nonTicketed
}

enum SeatSection {
  orchestraLeft
  orchestraRight
  orchestraMiddle
  balconyLeft
  balconyRight
  balconyMiddle
}

enum TicketActionType {
  allocate
  unallocate
  payToCCA
  unPayToCCA
  soldTicket
  unsoldTicket
  transfer
  refund
  remit
}

enum NotificationType {
  createShow
  createMajorProduction
  deleteShow
  archiveShow
  unarchiveShow
  addSchedule
  closeSchedule
  openSchedule
  deleteSchedule
  allocateTicket
  unallocateTicket
  remitTicket
  unremitTicket
  soldTicket
  unsoldTicket
  addHeadRole
}

enum UserRoleRole {
  head
  trainer
  distributor
}

enum TicketPricingType {
  fixed
  sectioned
}

enum DistributorTypes {
  cca
  visitor
  FOH
  faculty
  ticketBooth
}
